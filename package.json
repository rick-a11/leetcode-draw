{
  "name": "leetcode-draw",
  "version": "1.2.2",
  "description": "A local-first macOS question library and random draw app for LeetCode practice",
  "main": "dist-electron/main.js",
  "author": "LeetCode Draw contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && tsc -p tsconfig.json && vite build && node scripts/assert-packaged-assets.mjs && tsc -p electron/tsconfig.json && node scripts/assert-electron-bridge.mjs",
    "test": "vitest run",
    "dist": "npm run test && npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "electron-store": "^10.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.leetcode-draw.desktop",
    "productName": "LeetCode Draw",
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      "resources/icon.icns"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/examples",
        "to": "examples"
      }
    ],
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.education",
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "LeetCode-Draw-${version}-${arch}.dmg",
      "title": "LeetCode Draw"
    }
  }
}
